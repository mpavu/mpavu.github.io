---
import { siteConfig } from "../config";
import SectionHeading from "./SectionHeading.astro";
const studies = siteConfig.caseStudies ?? [];
const steps = [
  { key: "problem", label: "Problem" },
  { key: "action", label: "What I did" },
  { key: "result", label: "Result" },
  { key: "learning", label: "What I learned" },
] as const;
---

{
  studies.length > 0 && (
    <section id="work" class="max-w-7xl mx-auto px-6 sm:px-12 md:px-16 lg:px-24 py-16 md:py-24">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
        <SectionHeading label="selected work" title="Case Studies">
          <p class="mt-6 text-sm text-gray-500 dark:text-gray-400 max-w-xs">{siteConfig.caseStudyNote}</p>
        </SectionHeading>
        <div class="lg:col-span-8 space-y-8">
          {studies.map((cs, i) => (
            <article class="reveal rounded-2xl border border-gray-200 dark:border-white/10 bg-gray-50 dark:bg-white/[0.03] p-5 sm:p-8 hover:shadow-lg hover:border-gray-300 dark:hover:border-white/20 transition-all duration-300">
              <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
                <div>
                  <p class="font-mono text-sm text-[var(--accent)]">
                    0{i + 1} · {cs.tag}
                  </p>
                  <h3 class="mt-1 text-xl sm:text-2xl font-bold text-gray-900 dark:text-white">{cs.name}</h3>
                </div>
                <div class="sm:text-right shrink-0">
                  <p class="text-3xl font-extrabold text-[var(--accent)]">{cs.metric}</p>
                  <p class="text-xs text-gray-500 dark:text-gray-400 max-w-[12rem] sm:ml-auto">{cs.metricLabel}</p>
                </div>
              </div>

              <dl class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-5">
                {steps.map((s) => (
                  <div class={s.key === "learning" ? "md:col-span-2 rounded-lg bg-white dark:bg-white/5 border-l-4 border-[var(--accent)] p-4" : ""}>
                    <dt class="font-mono text-xs uppercase tracking-wider text-gray-500 dark:text-gray-400">{s.label}</dt>
                    <dd class="mt-1 text-sm sm:text-base leading-relaxed text-gray-700 dark:text-gray-300">{cs[s.key]}</dd>
                  </div>
                ))}
              </dl>

              <div class="mt-6 flex flex-wrap gap-2">
                {cs.skills.map((sk) => (
                  <span class="px-2.5 py-1 rounded-md bg-gray-900 dark:bg-white/10 text-white dark:text-gray-200 text-xs font-medium">{sk}</span>
                ))}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )
}
