---
import { siteConfig } from "../config";
import SectionHeading from "./SectionHeading.astro";
const education = siteConfig.education ?? [];
const awards = siteConfig.awards ?? [];
---

{
  (education.length > 0 || awards.length > 0) && (
    <section id="education" class="max-w-7xl mx-auto px-6 sm:px-12 md:px-16 lg:px-24 py-16 md:py-24">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
        <SectionHeading label="credentials" title="Education & Awards" />
        <div class="lg:col-span-8 space-y-10">
          <div class="space-y-6">
            {education.map((edu) => (
              <div class="reveal rounded-xl border border-gray-200 dark:border-white/10 p-5 sm:p-6">
                <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
                  <h3 class="text-lg sm:text-xl font-bold text-gray-900 dark:text-white">{edu.degree}</h3>
                  <span class="font-mono text-xs sm:text-sm text-gray-500 dark:text-gray-400 shrink-0 sm:ml-4">{edu.dateRange}</span>
                </div>
                <p class="mt-1 text-base font-medium text-[var(--accent)]">{edu.school}</p>
                <ul class="mt-3 space-y-1.5">
                  {edu.achievements.map((a) => (
                    <li class="flex items-start">
                      <span class="inline-block w-1.5 h-1.5 rounded-full bg-gray-400 mt-2.5 mr-3 shrink-0" />
                      <span class="text-sm sm:text-base text-gray-600 dark:text-gray-400">{a}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>

          {awards.length > 0 && (
            <div>
              <h3 class="font-mono text-sm uppercase tracking-wider text-gray-500 dark:text-gray-400">Recognition</h3>
              <ul class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-4">
                {awards.map((a) => (
                  <li class="reveal flex items-start gap-3 rounded-xl bg-gray-50 dark:bg-white/[0.03] border border-gray-200 dark:border-white/10 p-4">
                    <span class="text-2xl" aria-hidden="true">🏆</span>
                    <div>
                      <p class="font-bold text-gray-900 dark:text-white">{a.name}</p>
                      <p class="text-sm text-gray-600 dark:text-gray-400">
                        {a.org}
                        {a.year && ` · ${a.year}`}
                      </p>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </div>
    </section>
  )
}
