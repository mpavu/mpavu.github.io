---
import { siteConfig } from "../config";
import SectionHeading from "./SectionHeading.astro";
import Icon from "./Icon.astro";

const beyond = siteConfig.beyondWork;
const base = import.meta.env.BASE_URL;
const photos = beyond?.photos ?? [];
const currently = (beyond?.currently ?? []).filter((c) => c.label || c.value);
const interests = beyond?.interests ?? [];
const src = (path: string) => (/^https?:\/\//.test(path) ? path : `${base}${path.replace(/^\//, "")}`);
// Placeholder tints cycle through the palette
const tints = ["bg-blush", "bg-sky", "bg-gray-100", "bg-blush"];
---

{
  beyond && (
    <section id="beyond" class="max-w-7xl mx-auto px-6 sm:px-12 md:px-16 lg:px-24 py-16 md:py-24">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-end">
        <SectionHeading label="personal" title="Beyond Work" />
        <p class="lg:col-span-8 reveal text-lg sm:text-xl leading-relaxed text-gray-700 dark:text-gray-300">{beyond.intro}</p>
      </div>

      <div class="mt-10 grid grid-cols-2 lg:grid-cols-4 auto-rows-[minmax(170px,auto)] gap-4">
        {photos.map((ph, i) => {
          const place = i === 0 ? "col-span-2 row-span-2" : "col-span-1";
          const order = i === 0 ? "order-1" : i < 3 ? "order-3" : "order-4";
          return ph.image ? (
            <figure class:list={["reveal relative overflow-hidden rounded-2xl", place, order]}>
              <img src={src(ph.image)} alt={ph.alt || ph.caption} loading="lazy" class="absolute inset-0 h-full w-full object-cover" />
              {ph.caption && (
                <figcaption class="absolute left-3 bottom-3 rounded-full bg-cream/90 px-3 py-1 text-xs font-bold text-maroon">{ph.caption}</figcaption>
              )}
            </figure>
          ) : (
            <figure
              class:list={[
                "reveal flex flex-col items-center justify-center gap-2 rounded-2xl border-2 border-dashed border-maroon/25 dark:border-white/20 dark:bg-white/[0.03] text-center p-4",
                tints[i % tints.length],
                place,
                order,
              ]}
            >
              <Icon name="camera" class={i === 0 ? "h-10 w-10 text-maroon/60 dark:text-gray-400" : "h-7 w-7 text-maroon/60 dark:text-gray-400"} />
              <figcaption>
                <span class="block font-bold text-maroon dark:text-gray-200">{ph.caption || "Photo"}</span>
                <span class="block font-mono text-[11px] uppercase tracking-wider text-maroon/60 dark:text-gray-400">Photo coming soon</span>
              </figcaption>
            </figure>
          );
        })}

        {currently.length > 0 && (
          <div class="reveal order-2 col-span-2 rounded-2xl bg-maroon p-6 text-cream">
            <p class="font-mono text-xs uppercase tracking-widest text-blush">Right now</p>
            <dl class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-4">
              {currently.map((c) => (
                <div>
                  <dt class="font-mono text-[11px] uppercase tracking-wider text-tangerine">{c.label}</dt>
                  <dd class="mt-0.5 font-semibold leading-snug">{c.value}</dd>
                </div>
              ))}
            </dl>
          </div>
        )}

        {beyond.languages && (
          <div class="reveal order-4 col-span-1 flex flex-col justify-between rounded-2xl bg-tangerine p-5 text-maroon">
            <p class="font-mono text-xs uppercase tracking-widest">I speak</p>
            <p class="mt-3 text-lg font-extrabold leading-snug">{beyond.languages}</p>
          </div>
        )}

        {interests.length > 0 && (
          <div class="reveal order-5 col-span-2 rounded-2xl border border-gray-200 dark:border-white/10 bg-white dark:bg-white/[0.03] p-6">
            <p class="font-mono text-xs uppercase tracking-widest text-gray-500 dark:text-gray-400">Things I love</p>
            <ul class="mt-4 flex flex-wrap gap-2">
              {interests.map((it) => (
                <li class="inline-flex items-center gap-2 rounded-full bg-gray-100 dark:bg-white/10 px-3 py-1.5 text-sm font-semibold text-gray-800 dark:text-gray-200">
                  <span aria-hidden="true">{it.emoji}</span>
                  {it.label}
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </section>
  )
}
