---
interface Props {
  label: string;
  title: string;
}
const { label, title } = Astro.props;
---

<div class="lg:col-span-4 lg:sticky lg:top-24">
  <p class="font-mono text-sm text-[var(--accent)]">// {label}</p>
  <h2 class="mt-2 text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-gray-900 dark:text-white">
    {title}
  </h2>
  <div class="w-[75px] h-[5px] mt-3 rounded-full bg-[var(--accent)]"></div>
  <slot />
</div>
