---
import { siteConfig } from "../config";
import SectionHeading from "./SectionHeading.astro";
---

<section id="about" class="max-w-7xl mx-auto px-6 sm:px-12 md:px-16 lg:px-24 py-16 md:py-24">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
    <SectionHeading label="about" title="About Me" />
    <div class="lg:col-span-8 space-y-10 reveal">
      <div class="space-y-5">
        {
          siteConfig.aboutMe.map((p, i) => (
            <p class={i === 0 ? "text-lg sm:text-xl md:text-2xl leading-relaxed text-gray-700 dark:text-gray-200" : "text-base sm:text-lg leading-relaxed text-gray-600 dark:text-gray-400"}>
              {p}
            </p>
          ))
        }
      </div>
      <dl class="grid grid-cols-1 sm:grid-cols-2 gap-px overflow-hidden rounded-xl border border-gray-200 dark:border-white/10 bg-gray-200 dark:bg-white/10">
        {
          siteConfig.snapshot.map((row) => (
            <div class="bg-white dark:bg-night p-4">
              <dt class="font-mono text-xs uppercase tracking-wider text-gray-500 dark:text-gray-400">{row.label}</dt>
              <dd class="mt-1 font-medium text-gray-900 dark:text-gray-100">{row.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
