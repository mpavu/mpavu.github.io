---
import { siteConfig } from "../config";
import Icon from "./Icon.astro";

// Coinfluence (featuredProject) is shown as a regular card, first in the grid
const fp = siteConfig.featuredProject;
const fpCard = fp
  ? { name: fp.name, status: "Independent build", description: fp.summary, skills: fp.stack ?? [], categories: fp.categories ?? [], link: "" }
  : null;
const projects = [...(fpCard ? [fpCard] : []), ...(siteConfig.projects ?? [])];
const categories = (siteConfig.projectCategories ?? []).filter(Boolean);
const isExternal = (link: string) => /^https?:\/\//.test(link);
---

{
  projects.length > 0 && (
    <section id="projects" class="max-w-7xl mx-auto px-6 sm:px-12 md:px-16 lg:px-24 py-16 md:py-24">
      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6">
        <div>
          <p class="font-mono text-sm text-[var(--accent)]">// building</p>
          <h2 class="mt-2 text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-gray-900 dark:text-white">Projects</h2>
          <div class="w-[75px] h-[5px] mt-3 rounded-full bg-[var(--accent)]" />
        </div>

        {categories.length > 0 && (
          <div role="group" aria-label="Filter projects by category" class="flex flex-wrap gap-2">
            {["All", ...categories].map((c, i) => (
              <button
                type="button"
                data-filter={i === 0 ? "*" : c}
                aria-pressed={i === 0 ? "true" : "false"}
                class="filter-btn rounded-full border border-gray-300 dark:border-white/20 px-4 py-2 text-sm font-semibold text-gray-700 dark:text-gray-200 hover:border-[var(--accent)] transition-colors"
              >
                {c}
              </button>
            ))}
          </div>
        )}
      </div>

      {projects.length > 0 && (
        <div class="mt-10 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 auto-rows-fr gap-4">
          {projects.map((project) => {
            const link = project.link || "";
            const Tag = link ? "a" : "div";
            const props = link ? (isExternal(link) ? { href: link, target: "_blank", rel: "noopener noreferrer" } : { href: link }) : {};
            const cats = (project.categories ?? []).filter(Boolean);
            return (
              <Tag
                {...props}
                data-project
                data-cats={cats.join(" ")}
                class="reveal group relative flex flex-col p-5 sm:p-6 bg-white dark:bg-white/[0.03] rounded-2xl border border-gray-200 dark:border-white/10 transition-all duration-300 hover:shadow-xl hover:-translate-y-1"
              >
                {link && (
                  <span class="absolute top-5 right-5 w-9 h-9 flex items-center justify-center bg-gray-900 dark:bg-white/10 rounded-full text-white transition-colors group-hover:bg-tangerine">
                    <Icon name="arrow" class="w-4 h-4" />
                  </span>
                )}
                <div class="flex flex-wrap items-center gap-1.5 pr-12 min-h-[1.375rem]">
                  {cats.map((c) => (
                    <span class="rounded-full bg-sky px-2.5 py-0.5 text-xs font-bold text-maroon">{c}</span>
                  ))}
                  {project.status && (
                    <span class="rounded-full bg-blush px-2.5 py-0.5 text-xs font-bold text-maroon">{project.status}</span>
                  )}
                </div>
                <p class="mt-3 pr-12 text-lg font-bold text-gray-900 dark:text-white">{project.name}</p>
                <p class="mt-2 text-sm leading-relaxed text-gray-600 dark:text-gray-400 flex-1">{project.description}</p>
                <div class="flex flex-wrap gap-1.5 pt-4">
                  {(project.skills ?? []).map((skill) => (
                    <span class="px-2.5 py-1 bg-gray-900 dark:bg-white/10 text-white dark:text-gray-200 rounded-md text-xs font-medium">{skill}</span>
                  ))}
                </div>
              </Tag>
            );
          })}
        </div>
      )}

      <p id="projects-empty" hidden class="mt-6 rounded-2xl border border-dashed border-gray-300 dark:border-white/20 p-8 text-center text-gray-500 dark:text-gray-400">
        No projects in this category yet.
      </p>
      <p id="projects-status" class="sr-only" aria-live="polite"></p>
    </section>
  )
}

<style>
  .filter-btn[aria-pressed="true"] {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }
</style>

<script>
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>(".filter-btn"));
  const items = Array.from(document.querySelectorAll<HTMLElement>("#projects [data-project]"));
  const empty = document.getElementById("projects-empty");
  const status = document.getElementById("projects-status");

  buttons.forEach((btn) =>
    btn.addEventListener("click", () => {
      const f = btn.dataset.filter!;
      buttons.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
      let shown = 0;
      items.forEach((el) => {
        const cats = (el.dataset.cats || "").split(" ").filter(Boolean);
        const show = f === "*" || cats.includes(f);
        el.hidden = !show;
        if (show) {
          shown++;
          el.classList.add("is-visible");
        }
      });
      if (empty) empty.hidden = shown > 0;
      if (status) status.textContent = `${shown} project${shown === 1 ? "" : "s"} shown`;
    }),
  );
</script>
