---
import { siteConfig } from "../config";
---

<footer class="border-t border-gray-200 dark:border-white/10 bg-gray-50 dark:bg-white/[0.02]">
  <div class="max-w-7xl mx-auto px-6 sm:px-12 md:px-16 lg:px-24 pt-10 pb-24 lg:pb-10 flex flex-col md:flex-row md:items-center md:justify-between gap-4 text-sm text-gray-600 dark:text-gray-400">
    <p>
      © {new Date().getFullYear()} {siteConfig.name} · {siteConfig.location}
    </p>
    <p>
      Built with <a href="https://astro.build" class="underline hover:text-[var(--accent)]" target="_blank" rel="noopener noreferrer">Astro</a>
      on the open-source
      <a href="https://github.com/RyanFitzgerald/devportfolio" class="underline hover:text-[var(--accent)]" target="_blank" rel="noopener noreferrer">DevPortfolio</a>
      template (MIT) · <a href="#hero" class="underline hover:text-[var(--accent)]">Back to top ↑</a>
    </p>
  </div>
</footer>
