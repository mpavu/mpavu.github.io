---
import { siteConfig } from "../config";
import SectionHeading from "./SectionHeading.astro";
const groups = siteConfig.skillGroups ?? [];
---

{
  groups.length > 0 && (
    <section id="skills" class="max-w-7xl mx-auto px-6 sm:px-12 md:px-16 lg:px-24 py-16 md:py-24">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
        <SectionHeading label="toolkit" title="Skills" />
        <div class="lg:col-span-8 grid grid-cols-1 sm:grid-cols-2 gap-8">
          {groups.map((g) => (
            <div class="reveal">
              <h3 class="font-mono text-sm uppercase tracking-wider text-gray-500 dark:text-gray-400">{g.name}</h3>
              <div class="mt-3 flex flex-wrap gap-2">
                {g.items.map((s) => (
                  <span class="px-3 py-1.5 bg-gray-100 dark:bg-white/5 text-gray-800 dark:text-gray-200 rounded-full text-sm font-medium hover:bg-gray-200 dark:hover:bg-white/10 transition-colors">{s}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}
