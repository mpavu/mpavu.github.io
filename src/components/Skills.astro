---
import { siteConfig } from "../config";
import SectionHeading from "./SectionHeading.astro";
const groups = siteConfig.skillGroups ?? [];
---

{
  groups.length > 0 && (
    <section id="skills" class="max-w-7xl mx-auto px-6 sm:px-12 md:px-16 lg:px-24 py-16 md:py-24">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
        <SectionHeading label="toolkit" title="Skills" />
        <div class="lg:col-span-8 grid grid-cols-1 sm:grid-cols-2 gap-6">
          {groups.map((g) => (
            <div class="reveal rounded-xl border border-gray-200 dark:border-white/10 p-5">
              <h3 class="font-bold text-gray-900 dark:text-white">{g.name}</h3>
              <div class="mt-3 flex flex-wrap gap-2">
                {g.items.map((s) => (
                  <span class="px-3 py-1.5 bg-gray-100 dark:bg-white/5 text-gray-800 dark:text-gray-200 rounded-full text-sm font-medium">{s}</span>
                ))}
              </div>
              {g.proof && g.proof.length > 0 && (
                <p class="mt-4 text-sm text-gray-500 dark:text-gray-400">
                  <span class="font-mono text-xs uppercase tracking-wider mr-1">Shown in</span>
                  {g.proof.map((p, i) => (
                    <>
                      {i > 0 && " · "}
                      <a href={p.href} class="font-medium text-[var(--accent)] dark:text-teal-300 underline-offset-2 hover:underline">{p.label}</a>
                    </>
                  ))}
                </p>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}
