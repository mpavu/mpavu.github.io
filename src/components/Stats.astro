---
import { siteConfig } from "../config";
const stats = siteConfig.stats ?? [];
---

{
  stats.length > 0 && (
    <section aria-label="Impact at a glance" class="border-y border-gray-200 dark:border-white/10 bg-gray-50/80 dark:bg-white/[0.03]">
      <dl class="max-w-7xl mx-auto px-6 sm:px-12 md:px-16 lg:px-24 py-10 grid grid-cols-2 lg:grid-cols-4 gap-8">
        {stats.map((s) => (
          <div class="reveal">
            <dt class="sr-only">{s.label}</dt>
            <dd class="text-4xl md:text-5xl font-extrabold tracking-tight text-[var(--accent)]">{s.value}</dd>
            <dd class="mt-1 text-sm sm:text-base text-gray-600 dark:text-gray-400">{s.label}</dd>
          </div>
        ))}
      </dl>
    </section>
  )
}
